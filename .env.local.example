# App Check debug token (Firebase console -> App Check -> Apps -> Manage debug tokens)
# or: firebase appcheck:debugtokens:create --app <appId>
# Debug tokens are secrets. Keep the real value in .env.local only.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional: production attestation provider site key
VITE_RECAPTCHA_SITE_KEY=
